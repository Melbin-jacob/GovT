 },
 "status": "published",
 "new_version": "1.1.0",
 "plan": {
  "clauses": {
   "en": {
    "new": {
     "6.1.2": "The register must record the owner, the location, the model and the firmware version of each widget.",
     "6.2.1": "Departments must complete a widget risk assessment before a widget is put into service.",
     "6.2.2": "The widget risk assessment must be updated when the purpose of the widget changes.",
     "6.3.1": "Widgets must be calibrated at least once a year.",
     "6.3.2": "Calibration results must be reviewed by a qualified technician.",
     "6.3.3": "Faulty widgets must be removed from service until they are repaired.",
     "6.4.1": "Operators must log every calibration.",
     "6.4.2": "Operators must retain the calibration log for two years.",
     "6.5.1": "Clients are informed when a widget is used to process their request.",
     "6.5.2": "Departments report annually on the number of widgets in service. The report covers the fiscal year."
    },
    "old": {
     "6.1.2": "The register must record the owner, the location and the model of each widget.",
     "6.2.1": "Widgets should be calibrated at least once a year.",
     "6.2.2": "Calibration results must be reviewed by a qualified technician.",
     "6.2.3": "Faulty widgets must be removed from service until they are repaired.",
     "6.3.1": "Operators must log every calibration and must retain the log for two years.",
     "6.3.2": "The widget register may be published on the department's website.",
     "6.4.1": "Clients are informed when a widget is used to process their request.",
     "6.4.2": "Departments report annually on the number of widgets in service."
    }
   },
   "fr": {
    "new": {
     "6.1.2": "Le registre doit consigner le propriétaire, l’emplacement, le modèle et la version du micrologiciel de chaque widget.",
     "6.2.1": "Les ministères doivent réaliser une évaluation des risques du widget avant sa mise en service.",
     "6.2.2": "L’évaluation des risques du widget doit être mise à jour lorsque l’objet du widget change.",
     "6.3.1": "Les widgets doivent être étalonnés au moins une fois par année.",
     "6.3.2": "Les résultats d’étalonnage doivent être examinés par un technicien qualifié.",
     "6.3.3": "Les widgets défectueux doivent être retirés du service jusqu’à leur réparation.",
     "6.4.1": "Les opérateurs doivent consigner chaque étalonnage.",
     "6.4.2": "Les opérateurs doivent conserver le journal d’étalonnage pendant deux ans.",
     "6.5.1": "Les clients sont informés lorsqu’un widget sert à traiter leur demande.",
     "6.5.2": "Les ministères font rapport chaque année sur le nombre de widgets en service. Le rapport porte sur l’exercice financier."
    },
    "old": {
     "6.1.2": "Le registre doit consigner le propriétaire, l'emplacement et le modèle de chaque widget.",
     "6.2.1": "Les widgets devraient être étalonnés au moins une fois par année.",
     "6.2.2": "Les résultats d'étalonnage doivent être examinés par un technicien qualifié.",
     "6.2.3": "Les widgets défectueux doivent être retirés du service jusqu'à leur réparation.",
     "6.3.1": "Les opérateurs doivent consigner chaque étalonnage et doivent conserver le journal pendant deux ans.",
     "6.3.2": "Le registre des widgets peut être publié sur le site Web du ministère.",
     "6.4.1": "Les clients sont informés lorsqu'un widget sert à traiter leur demande.",
     "6.4.2": "Les ministères font rapport chaque année sur le nombre de widgets en service."
    }
   }
  },
